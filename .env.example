# Phoenix Command — build/runtime configuration.
# Copy to .env for local development, or set in the build environment for
# production. All values are required unless marked optional; production
# builds fail fast when they are missing (build/runtime-origin.js and
# build/azure-env.js enforce this).

# Public HTTPS gateway base URL of the Phoenix runtime.
VITE_API_BASE=

# Azure AD app registration (Phoenix Mail Courier) used for MSAL sign-in.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# Optional: override the API token scope. Defaults to api://<client-id>/.default
VITE_API_SCOPE=
